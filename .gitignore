# Cross-compiled binaries
/build/

# Vendored upgrade_tool — redistributable only from Luckfox; see CLAUDE.md Setup
/tools/
# Exception: fb2png source should be tracked
!/tools/fb2png/
!/tools/fb2png/**.go

# Firmware images and device-tree dumps pulled off the board
*.img
*.dtb
*.dtbo
*.raw
*.bin

.DS_Store

# Google OAuth credentials and tokens. The client secret identifies the app and
# a refresh token grants calendar access until revoked -- neither belongs in a
# repo, and both are read from disk at runtime (see internal/googleauth).
/google-client.json
/google-token*.json
/google-tokens/
*.token.json
