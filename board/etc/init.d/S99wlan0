#!/bin/sh
#
# Bring up wlan0, associate, get a lease, and set the clock.
#
# The board has no RTC and boots at 1970, so the clock is set from the network
# once an address exists. rdate is used because this Buildroot image ships no
# ntpd/ntpdate/chrony -- see `busybox --list`.
#
# Credentials live in /etc/wpa_supplicant.conf (written by wifi-connect.sh).

RDATE_HOSTS="time.nist.gov pool.ntp.org"

start() {
	printf "Starting wlan0: "

	# The aic8800 modules are auto-loaded by S03modules_init.sh; if that has
	# not happened yet (boot ordering), pull them in here.
	[ -d /sys/class/net/wlan0 ] || modprobe aic8800_fdrv 2>/dev/null

	# Wait for the interface to appear -- the USB probe is not instant.
	i=0
	while [ ! -d /sys/class/net/wlan0 ] && [ $i -lt 20 ]; do
		sleep 0.5
		i=$((i + 1))
	done
	if [ ! -d /sys/class/net/wlan0 ]; then
		echo "FAIL (no wlan0)"
		return 1
	fi

	ip link set wlan0 up

	if ! pidof wpa_supplicant >/dev/null 2>&1; then
		wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf >/dev/null 2>&1
	fi

	# Wait for association before asking for a lease.
	i=0
	while [ $i -lt 30 ]; do
		if wpa_cli -i wlan0 status 2>/dev/null | grep -q "wpa_state=COMPLETED"; then
			break
		fi
		sleep 1
		i=$((i + 1))
	done

	udhcpc -i wlan0 -n -q >/dev/null 2>&1
	if ip -o addr show wlan0 2>/dev/null | grep -q "inet "; then
		echo "OK"
	else
		echo "FAIL (no lease)"
		return 1
	fi

	# Clock: try each host, stop at the first that answers.
	for h in $RDATE_HOSTS; do
		if rdate -s "$h" >/dev/null 2>&1; then
			echo "Clock set from $h: $(date)"
			break
		fi
	done
}

stop() {
	printf "Stopping wlan0: "
	killall wpa_supplicant 2>/dev/null
	ip link set wlan0 down 2>/dev/null
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
