#!/bin/sh
#
# Start the UpNext dashboard.
#
# Named S99z* so it sorts after S99wlan0: rcS runs these sequentially, and
# wlan0 blocks for up to ~45s waiting on association and DHCP. The dashboard
# tolerates having no network (it renders the clock and a STALE flag), so this
# is only about getting live data into the first frame rather than the second.

DAEMON=/root/dashboard
CONFIG=/root/config.json
LOGFILE=/root/dashboard.log
PIDFILE=/var/run/dashboard.pid

[ -x "$DAEMON" ] || exit 0

start() {
	printf "Starting dashboard: "

	if [ ! -f "$CONFIG" ]; then
		echo "FAIL (no $CONFIG)"
		return 1
	fi

	# Truncate rather than append: /root is UBI on NAND with ~50MB free, and
	# this runs every minute forever. Keeping only the current boot's log
	# bounds the growth without needing logrotate.
	: > "$LOGFILE"

	start-stop-daemon --start --quiet --background \
		--make-pidfile --pidfile "$PIDFILE" \
		--exec "$DAEMON" -- --config "$CONFIG" >>"$LOGFILE" 2>&1
	status=$?

	if [ $status -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return $status
}

stop() {
	printf "Stopping dashboard: "
	start-stop-daemon --stop --quiet --oknodo --retry 5 --pidfile "$PIDFILE"
	status=$?
	rm -f "$PIDFILE"
	[ $status -eq 0 ] && echo "OK" || echo "FAIL"
	return $status
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart | reload)
		stop
		sleep 1
		start
		;;
	status)
		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "dashboard running (pid $(cat "$PIDFILE"))"
		else
			echo "dashboard not running"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 1
		;;
esac

exit $?
