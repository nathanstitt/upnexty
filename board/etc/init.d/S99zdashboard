#!/bin/sh
#
# Start the UpNext dashboard under a supervisor that restarts it when it dies.
#
# Named S99z* so it sorts after S99wlan0: rcS runs these sequentially, and
# wlan0 blocks for up to ~45s waiting on association and DHCP. The dashboard
# tolerates having no network (it renders the clock and a STALE flag), so this
# is only about getting live data into the first frame rather than the second.
#
# The supervisor exists because of docs/crashes/README.md: eight times in
# eight days the process died with the board healthy, and each time the panel
# sat frozen on its last frame until someone noticed. Every exit now restarts
# it within seconds, after saving the log it left behind -- the crash logs are
# the evidence the lockup investigation runs on, and a bare restart would
# overwrite them.

DAEMON=/root/dashboard
CONFIG=/root/config.json
LOGFILE=/root/dashboard.log
# One file per exit, named by the time it happened, so a run of crashes is
# preserved in order. /root is UBI with ~45MB free and a crash log is under
# 100KB; KEEP_CRASHES bounds the directory anyway.
CRASHDIR=/root/crashes
KEEP_CRASHES=20
SUPLOG=/root/supervisor.log
PIDFILE=/var/run/dashboard.pid         # the dashboard process itself
SUPPIDFILE=/var/run/dashboard-sup.pid  # the supervisor loop
STOPFLAG=/var/run/dashboard.stop       # set by stop(): an exit is not a crash

[ -x "$DAEMON" ] || exit 0

# Go writes a fatal stack to stderr, which the log captures. That is the only
# crash evidence available here: this kernel has coredump support compiled
# out. Setting ulimit -c and core_pattern looks like it works -- both take,
# and /proc/PID/limits reports "unlimited" -- but nothing is ever written.
# Verified by SEGV-ing a shell with the limit raised and the pattern set to an
# absolute path, which produced no file either.
#
# So the stack has to be sufficient, which means GOTRACEBACK and an unstripped
# binary when hunting something the unwinder cannot walk.
#
# GOTRACEBACK=crash would re-raise for a core on a kernel that supported them;
# it is deliberately not set, because without coredump support it only adds
# runtime frames to a stack that is already long.
GOTRACEBACK=all
export GOTRACEBACK

# save_crash_log copies the log of a run that just ended into CRASHDIR and
# prunes the directory to KEEP_CRASHES files, oldest first.
save_crash_log() {
	mkdir -p "$CRASHDIR"
	cp "$LOGFILE" "$CRASHDIR/dashboard-$1.log" 2>/dev/null
	n=$(ls "$CRASHDIR" 2>/dev/null | wc -l)
	while [ "$n" -gt "$KEEP_CRASHES" ]; do
		oldest=$(ls "$CRASHDIR" | head -1)
		[ -n "$oldest" ] || break
		rm -f "$CRASHDIR/$oldest"
		n=$((n - 1))
	done
}

# supervise runs the dashboard and restarts it whenever it exits, unless
# stop() has asked it not to. The delay between restarts doubles while the
# process keeps dying inside its first minute -- a binary that faults at
# startup, a bad config -- and drops back to five seconds once a run lasts.
# Restarting a startup fault every few seconds forever would fill /root with
# identical crash logs and hide the real problem behind a blinking panel.
supervise() {
	delay=5
	while :; do
		started=$(cut -d. -f1 /proc/uptime)
		"$DAEMON" --config "$CONFIG" >>"$LOGFILE" 2>&1 &
		echo $! > "$PIDFILE"
		wait $!
		rc=$?
		rm -f "$PIDFILE"
		if [ -f "$STOPFLAG" ]; then
			exit 0
		fi
		ran=$(( $(cut -d. -f1 /proc/uptime) - started ))
		stamp=$(date -u +%Y-%m-%dT%H%M%SZ)
		save_crash_log "$stamp"
		echo "$stamp dashboard exited rc=$rc after ${ran}s; restarting in ${delay}s" >> "$SUPLOG"
		sleep "$delay"
		if [ -f "$STOPFLAG" ]; then
			exit 0
		fi
		if [ "$ran" -lt 60 ]; then
			delay=$((delay * 2))
			[ "$delay" -gt 300 ] && delay=300
		else
			delay=5
		fi
		: > "$LOGFILE"
	done
}

start() {
	printf "Starting dashboard: "

	if [ ! -f "$CONFIG" ]; then
		echo "FAIL (no $CONFIG)"
		return 1
	fi
	if [ -f "$SUPPIDFILE" ] && kill -0 "$(cat "$SUPPIDFILE")" 2>/dev/null; then
		echo "already running (supervisor pid $(cat "$SUPPIDFILE"))"
		return 0
	fi

	# Keep one generation before truncating. /root is UBI on NAND with ~50MB
	# free and this runs every minute forever, so the log cannot simply grow --
	# but truncating outright destroys the evidence in the one case that
	# matters: a process that died and is being restarted, whose stack is in
	# the log we are about to erase. (The supervisor saves each exit's log to
	# CRASHDIR as well; this covers a restart of the service itself.)
	[ -s "$LOGFILE" ] && mv "$LOGFILE" "$LOGFILE.1"
	: > "$LOGFILE"
	rm -f "$STOPFLAG"

	# Detach the kernel's text console from the framebuffer. fbcon shares
	# /dev/fb0 and keeps drawing its caret on top of whatever we write -- a
	# small grey block near the top-left of the panel that blinks roughly once
	# a second. Clearing cursor_blink alone only freezes it visible; the
	# console has to be unbound.
	#
	# Guarded because it is not worth failing to start over, and vtcon
	# numbering is not guaranteed: pick the console that names itself the
	# frame buffer device rather than hardcoding vtcon1.
	#
	# KEEP_FBCON=1 leaves the console attached, trading the caret for the
	# ability to see a kernel oops on the panel. That matters while the
	# lockups are unexplained: with fbcon unbound the kernel has no path to
	# the display at all, so a panic goes only to ttyFIQ0 (which nothing is
	# reading) and ramoops -- which is why every lockup so far has shown a
	# frozen dashboard frame rather than a trace. See docs/lockups.md.
	#
	# The caret is only a nuisance while the board is healthy. Once it dies
	# the dashboard stops rendering, so there is nothing left to overwrite an
	# oops. Set it in /etc/default/dashboard to survive a reboot.
	[ -f /etc/default/dashboard ] && . /etc/default/dashboard
	if [ "${KEEP_FBCON:-0}" = "1" ]; then
		echo "  (KEEP_FBCON=1: leaving kernel console on the panel)"
	else
		for vt in /sys/class/vtconsole/vtcon*; do
			if grep -qi "frame buffer" "$vt/name" 2>/dev/null; then
				echo 0 > "$vt/bind" 2>/dev/null
			fi
		done
	fi

	# The supervisor is this script re-entered with a private action, run
	# under setsid so it survives the init shell going away. The dashboard's
	# own stdout and stderr are redirected by the supervisor into $LOGFILE.
	#
	# Not start-stop-daemon --background: BusyBox's reopens the child's stdout
	# and stderr on /dev/null unconditionally and has no option to redirect
	# them, which once silently discarded every crash stack (a Go runtime
	# fault goes to stderr). Verified by reading /proc/PID/fd/2 on the running
	# daemon, which is the only way to see it -- an empty log is exactly what a
	# healthy service looks like too.
	setsid sh "$0" supervise >/dev/null 2>&1 &
	echo $! > "$SUPPIDFILE"

	# A fault at startup (bad config, missing framebuffer) exits within a
	# second, and reporting OK for a process that is already gone is worse than
	# a slow start. Confirm the dashboard itself is alive before claiming
	# success; the supervisor will keep retrying either way.
	sleep 2
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "OK"
		return 0
	fi
	echo "FAIL (see $LOGFILE; the supervisor keeps retrying)"
	return 1
}

stop() {
	printf "Stopping dashboard: "
	# Order matters: flag first so the supervisor treats the exit as a stop
	# rather than a crash, then the dashboard, then the supervisor in case it
	# is asleep between retries.
	: > "$STOPFLAG"
	start-stop-daemon --stop --quiet --oknodo --retry 5 --pidfile "$PIDFILE"
	status=$?
	if [ -f "$SUPPIDFILE" ]; then
		kill "$(cat "$SUPPIDFILE")" 2>/dev/null
		rm -f "$SUPPIDFILE"
	fi
	rm -f "$PIDFILE" "$STOPFLAG"

	# Give the console back. Without this a stopped dashboard leaves a frozen
	# last frame and no way to see boot or kernel messages on the panel.
	for vt in /sys/class/vtconsole/vtcon*; do
		if grep -qi "frame buffer" "$vt/name" 2>/dev/null; then
			echo 1 > "$vt/bind" 2>/dev/null
		fi
	done

	[ $status -eq 0 ] && echo "OK" || echo "FAIL"
	return $status
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart | reload)
		stop
		sleep 1
		start
		;;
	status)
		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "dashboard running (pid $(cat "$PIDFILE"))"
		elif [ -f "$SUPPIDFILE" ] && kill -0 "$(cat "$SUPPIDFILE")" 2>/dev/null; then
			echo "dashboard not running; supervisor (pid $(cat "$SUPPIDFILE")) is between retries"
			tail -1 "$SUPLOG" 2>/dev/null
			exit 1
		else
			echo "dashboard not running"
			exit 1
		fi
		;;
	supervise)
		# Private: the loop start() launches. Not for hand use.
		supervise
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 1
		;;
esac

exit $?
